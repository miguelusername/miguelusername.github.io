# Copy to .env and adjust. Every value is optional; defaults are shown.
PORT=3000
CORS_ORIGIN=http://localhost:5173

MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=frogblog
MONGODB_REPLICA_SET=rs0
# Leave blank for an unauthenticated local instance.
MONGODB_USERNAME=
MONGODB_PASSWORD=

POSTS_PAGE_SIZE=20
POSTS_MAX_PAGE_SIZE=50
